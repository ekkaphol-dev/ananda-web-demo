# คัดลอกเป็น .env.local (เครื่องตัวเอง) หรือใส่ใน Vercel → Settings → Environment Variables
# ไม่ใส่ค่า = ไม่โหลด Google tag และไม่แสดงแบนเนอร์คุกกี้

# โดเมนจริงของเว็บ (ใช้ทำ canonical / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://ananda-web-demo.vercel.app

# Google Ads: Tools → Conversions → เลือก conversion action → Tag setup → Use Google tag
# send_to จะอยู่ในรูป AW-123456789/AbC-D_efG-h12_34-567  →  ID = ส่วนหน้า "/" , LABEL = ส่วนหลัง "/"
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_RENT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_INVEST=

# Google Analytics 4 (ไม่บังคับ) เช่น G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Search Console: ค่า content ของ meta tag ยืนยันความเป็นเจ้าของ (ไม่บังคับ ถ้ายืนยันผ่าน DNS แล้ว)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
